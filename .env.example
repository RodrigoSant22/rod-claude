# Copie para .env e ajuste. O arquivo .env não vai para o Git.

FLASK_ENV=development

# Assina os cookies de sessão: quem souber esta chave consegue forjar um
# login. Gere uma própria com:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-por-um-valor-aleatorio

# Padrão é SQLite em instance/app.db. Para Postgres:
# DATABASE_URL=postgresql://usuario:senha@localhost:5432/rod_claude

# SMTP para a recuperação de senha. Sem MAIL_SERVER, o link é escrito no
# log do servidor em vez de enviado — que é o suficiente para uso local.
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=voce@gmail.com
# MAIL_PASSWORD=senha-de-aplicativo
# MAIL_USE_TLS=true
# MAIL_FROM=voce@gmail.com
